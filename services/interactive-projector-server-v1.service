[Unit]
Description=Interactive Projector - Touch Processing Server (Kinect v1)
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/interactive-projector
ExecStart=/usr/bin/python3 /home/pi/interactive-projector/src/server_v1.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
