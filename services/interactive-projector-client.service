[Unit]
Description=Interactive Projector - Touch Receiver Client
After=network.target graphical.target

[Service]
Type=simple
User=ubuntu
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/ubuntu/.Xauthority
WorkingDirectory=/home/ubuntu/interactive-projector
ExecStart=/usr/bin/python3 /home/ubuntu/interactive-projector/src/client.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target