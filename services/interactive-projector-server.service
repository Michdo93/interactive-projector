[Unit]
Description=Interactive Projector - Touch Processing Server
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/interactive-projector
ExecStart=/usr/bin/python3 /home/pi/interactive-projector/src/server.py
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target