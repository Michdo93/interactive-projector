[Unit]
Description=Interactive Projector - Standalone Touch (Kinect v1)
After=graphical.target

[Service]
Type=simple
User=ubuntu
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/ubuntu/.Xauthority
Environment=PYTHONUNBUFFERED=1
WorkingDirectory=/home/ubuntu/interactive-projector
ExecStart=/usr/bin/python3 /home/ubuntu/interactive-projector/src/main_v1.py
Restart=always
RestartSec=5

[Install]
WantedBy=graphical.target
